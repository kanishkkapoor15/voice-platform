# Voice Platform Lua agent environment example.
# Prefer setting these through Lua CLI:
#   npx lua-cli env sandbox -k POSTGRES_URL -v "<postgres-url>"
#   npx lua-cli env production -k POSTGRES_URL -v "<postgres-url>"

# Required for DB-backed pipeline tools.
POSTGRES_URL=

# Optional. If unset, invitation email bodies are logged/returned for manual outreach.
RESEND_API_KEY=
RESEND_FROM="Voice Platform <hello@voiceplatform.com>"

# Optional for local CLI/CI auth if keychain auth is unavailable.
LUA_API_KEY=
