# Tensorix API key — used for all LLM and embedding calls (DeepSeek-V3.2, R1, Qwen3)
TENSORIX_API_KEY=

# Postgres connection string (Neon, Supabase, or Vercel Postgres). Must support pgvector.
POSTGRES_URL=

# Resend API key for sending invitation emails. If unset, emails are logged to console.
RESEND_API_KEY=

# NextAuth session secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL for NextAuth callbacks. Use http://localhost:3000 in dev.
NEXTAUTH_URL=http://localhost:3000
